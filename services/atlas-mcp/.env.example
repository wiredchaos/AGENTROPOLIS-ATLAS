# Phase 001 defaults to deterministic local mock adapters.
ATLAS_PROVIDER_MODE=mock

# Identity must come from the trusted runtime or launcher, never the tool payload.
ATLAS_AUTHENTICATED_PRINCIPAL=agent://neuro/navigation

# Future self-hosted provider endpoints. Never commit secrets.
ATLAS_POSTGIS_URL=
ATLAS_PELIAS_URL=
ATLAS_NOMINATIM_URL=
ATLAS_VALHALLA_URL=
ATLAS_OSRM_URL=
ATLAS_OVERPASS_URL=
ATLAS_MARTIN_URL=
ATLAS_PMTILES_URL=

# Governance controls
ATLAS_DEFAULT_MAX_RADIUS_METERS=5000
ATLAS_MAX_RESULT_LIMIT=100
ATLAS_REQUIRE_ATTRIBUTION=true
ATLAS_ALLOW_PUBLIC_FALLBACKS=false
